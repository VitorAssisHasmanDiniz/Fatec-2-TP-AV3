# Banco de dados principal (desenvolvimento/produção)
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"

# Banco de dados descartável para testes de integração (NUNCA aponte para produção/dev)
TEST_DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode_test?schema=public"

# Autenticação JWT
JWT_SECRET="troque-esta-chave-secreta-em-producao"
JWT_EXPIRES_IN="8h"

# Servidor HTTP e Proxy Reverso
PORT=3000
# Quantidade de hops confiáveis atrás de proxy reverso (ex.: 1 para Nginx/ALB; 0 ou vazio desativa)
TRUST_PROXY=0

# Redis (BullMQ e rate limit opcional)
REDIS_URL="redis://localhost:6379"

# Armazenamento do rate limit da API pública: "memory" (padrão) ou "redis" (com fallback para memória)
RATE_LIMIT_STORE="memory"

# Agendamento de análises: "local" (node-cron no servidor) ou "worker" (scheduler distribuído no BullMQ)
ANALYTICS_AGENDADOR="local"
ANALYTICS_CRON_EFICIENCIA=""
ANALYTICS_CRON_RENTABILIDADE=""
ANALYTICS_CRON_VIDA_UTIL=""

# Relatórios assíncronos (Pilar 3)
REPORT_DIR="./storage/relatorios"
REPORT_CONCORRENCIA=3
REPORT_MAX_TENTATIVAS=3
REPORT_BACKOFF_MS=5000
REPORT_MAX_ATIVAS_POR_CHAVE=3
# Tempo até expirar o arquivo para download (dias)
REPORT_RETENCAO_DIAS=7
# Tempo após expiração para remover o registro histórico do banco (dias)
REPORT_RETENCAO_REGISTRO_DIAS=30
# Reconciliação banco x Redis (minutos)
REPORT_RECONCILIAR_MINUTOS=10
REPORT_TIMEOUT_EXECUCAO_MIN=30
