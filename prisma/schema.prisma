// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  nome         String       @db.VarChar(120)
  usuario      String       @unique @db.VarChar(40)
  senhaHash    String
  papel        PapelUsuario @default(OPERADOR_CADASTRO)
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  registrosAuditoria RegistroAuditoria[]
  lotesResponsavelTriagem Lote[] @relation("ResponsavelTriagem")
  resultadosEficiencia ResultadoEficienciaOperacional[]

  @@map("usuarios")
}

model Organizacao {
  id                 String    @id @db.VarChar(20)
  codigo             String?   @unique @db.VarChar(20)
  razaoSocial        String    @db.VarChar(200)
  cnpj               String    @unique @db.VarChar(14)
  inscricaoEstadual  String    @default("") @db.VarChar(30)
  enderecoCompleto   String    @default("") @db.Text
  telefone           String    @default("") @db.VarChar(20)
  email              String    @default("") @db.VarChar(254)
  dataCadastro       DateTime  @default(now())
  ativo              Boolean   @default(true)
  versao             Int       @default(1)
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
  lotes Lote[]

  contratoVigente    Contrato?
  relatoriosAnaliticos RelatorioAnalitico[]

  @@map("organizacoes")
}

model Contrato {
  id                  String   @id @default(uuid()) @db.Uuid
  organizacaoId       String   @unique @db.VarChar(20)
  dataAssinatura      DateTime @default(now())
  dataVencimento      DateTime
  clausulas           Int      @default(0)
  valorMensal         Decimal  @db.Decimal(12, 2)
  renovacaoAutomatica Boolean  @default(false)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
  CANCELADO
}

model Lote {
  id                 String     @id @db.VarChar(40)
  dataEntrada        DateTime   @default(now())
  organizacaoId      String     @db.VarChar(20)
  notaFiscal         String     @db.VarChar(100)
  transportadora     String     @db.VarChar(120)
  statusProcessamento StatusLote @default(RECEBIDO)
  observacoes        String     @default("") @db.Text

  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  equipamentos Equipamento[]
  triagemConcluidaEm DateTime?
  triagemResponsavelId String? @db.Uuid
  triagemResponsavel Usuario? @relation("ResponsavelTriagem", fields: [triagemResponsavelId], references: [id], onDelete: SetNull)

  @@index([triagemResponsavelId])
  @@index([organizacaoId])
  @@index([dataEntrada])
  @@map("lotes")
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Equipamento {
  id                   String              @id @default(uuid()) @db.Uuid
  codigoBarrasInterno  String              @unique
  tipo                 TipoEquipamento     @default(COMPUTADOR_MESA)
  marca                String              @default("")
  modelo               String              @default("")
  anoFabricacao        Int                 @default(0)
  estadoFisico         EstadoFisico        @default(NOVO)
  pesoQuilogramas      Float               @default(0)
  loteId               String              @db.VarChar(40)
  posicaoNoLote        Int                 @default(0)
  statusRastreamento   StatusRastreamento  @default(AGUARDANDO_TRIAGEM)

  lote                 Lote                @relation(fields: [loteId], references: [id], onDelete: Restrict)
  historicoMovimentacao Movimentacao[]
  registrosRecuperacao RegistroRecuperacao[]
  observacoesCondicao ObservacaoCondicaoEquipamento[]

  @@index([loteId])
  @@index([statusRastreamento])
  @@map("equipamentos")
}

model Movimentacao {
  id            String      @id @default(uuid()) @db.Uuid
  equipamentoId String      @db.Uuid
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")

  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataHora])
  @@map("movimentacoes")
}

model Configuracao {
  id                    Int      @id @default(1)
  aliquotaImposto       Float
  coeficienteDepreciacao Float
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@map("configuracao")
}

model RegistroAuditoria {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String?   @db.Uuid
  acao        String    @db.VarChar(100)
  entidade    String    @db.VarChar(100)
  entidadeId  String?   @db.VarChar(100)
  detalhes    Json?
  ip          String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  criadoEm    DateTime  @default(now())

  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@map("registros_auditoria")
}

enum TipoRelatorioAnalitico {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE_EQUIPAMENTOS
  PREVISAO_VIDA_UTIL
}

model RelatorioAnalitico {
  id String @id @default(uuid()) @db.Uuid
  tipo TipoRelatorioAnalitico
  organizacaoId String? @db.VarChar(20)
  geradoEm DateTime @default(now())
  versaoModelo String @db.VarChar(30)
  parametros Json
  resumo Json?
  resultadosEficiencia ResultadoEficienciaOperacional[]
  resultadosRentabilidade ResultadoRentabilidadeEquipamento[]
  resultadosVidaUtil ResultadoVidaUtil[]
  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)

  @@index([tipo, geradoEm])
  @@index([organizacaoId, geradoEm])
  @@map("relatorios_analiticos")
}

model ResultadoEficienciaOperacional {
  id String @id @default(uuid()) @db.Uuid
  relatorioId String @db.Uuid
  operadorId String? @db.Uuid
  nomeOperador String
  inicioPeriodo DateTime
  fimPeriodo DateTime
  unidadePeriodo String @db.VarChar(15)
  quantidadeLotes Int
  tempoMedioHoras Float
  tempoMedianoHoras Float
  desvioPadraoHoras Float
  gargalo Boolean @default(false)
  relatorio RelatorioAnalitico @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  operador Usuario? @relation(fields: [operadorId], references: [id], onDelete: SetNull)

  @@index([relatorioId])
  @@map("resultados_eficiencia_operacional")
}

model ResultadoRentabilidadeEquipamento {
  id String @id @default(uuid()) @db.Uuid
  relatorioId String @db.Uuid
  tipoEquipamento String
  estadoFisico String
  marca String
  modelo String
  quantidade Int
  valorTotalRecuperacao Decimal @db.Decimal(14,2)
  valorMedioRecuperacao Decimal @db.Decimal(14,2)
  posicaoRanking Int?
  relatorio RelatorioAnalitico @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

  @@index([relatorioId])
  @@map("resultados_rentabilidade_equipamento")
}

model ResultadoVidaUtil {
  id String @id @default(uuid()) @db.Uuid
  relatorioId String @db.Uuid
  tipoEquipamento String
  marca String
  modelo String
  amostras Int
  metodo String
  rQuadrado Float?
  vidaRemanescenteMeses Float?
  dataPrevistaInservivel DateTime?
  relatorio RelatorioAnalitico @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

  @@index([relatorioId])
  @@map("resultados_vida_util")
}

model RegistroRecuperacao {
  id String @id @default(uuid()) @db.Uuid
  equipamentoId String @db.Uuid
  registradoEm DateTime @default(now())
  valorRecuperacao Decimal @db.Decimal(14,2)
  observacao String @default("") @db.Text
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@index([equipamentoId, registradoEm])
  @@map("registros_recuperacao")
}

model ObservacaoCondicaoEquipamento {
  id String @id @default(uuid()) @db.Uuid
  equipamentoId String @db.Uuid
  observadoEm DateTime @default(now())
  indiceCondicao Float
  falhaRegistrada Boolean @default(false)
  observacao String @default("") @db.Text
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@index([equipamentoId, observadoEm])
  @@map("observacoes_condicao_equipamento")
}
