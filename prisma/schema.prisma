// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  nome         String       @db.VarChar(120)
  usuario      String       @unique @db.VarChar(40)
  senhaHash    String
  papel        PapelUsuario @default(OPERADOR_CADASTRO)
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  registrosAuditoria RegistroAuditoria[]
  lotesTriagemConcluida Lote[] @relation("ResponsavelTriagem")

  @@map("usuarios")
}

model Organizacao {
  id                 String    @id @db.VarChar(20)
  codigo             String?   @unique @db.VarChar(20)
  razaoSocial        String    @db.VarChar(200)
  cnpj               String    @unique @db.VarChar(14)
  inscricaoEstadual  String    @default("") @db.VarChar(30)
  enderecoCompleto   String    @default("") @db.Text
  telefone           String    @default("") @db.VarChar(20)
  email              String    @default("") @db.VarChar(254)
  dataCadastro       DateTime  @default(now())
  ativo              Boolean   @default(true)
  versao             Int       @default(1)
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
  lotes Lote[]

  contratoVigente    Contrato?

  @@map("organizacoes")
}

model Contrato {
  id                  String   @id @default(uuid()) @db.Uuid
  organizacaoId       String   @unique @db.VarChar(20)
  dataAssinatura      DateTime @default(now())
  dataVencimento      DateTime
  clausulas           Int      @default(0)
  valorMensal         Decimal  @db.Decimal(12, 2)
  renovacaoAutomatica Boolean  @default(false)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
  CANCELADO
}

model Lote {
  id                 String     @id @db.VarChar(40)
  dataEntrada        DateTime   @default(now())
  organizacaoId      String     @db.VarChar(20)
  notaFiscal         String     @db.VarChar(100)
  transportadora     String     @db.VarChar(120)
  statusProcessamento StatusLote @default(RECEBIDO)
  triagemConcluidaEm DateTime?
  triagemResponsavelId String? @db.Uuid
  observacoes        String     @default("") @db.Text

  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  triagemResponsavel Usuario? @relation("ResponsavelTriagem", fields: [triagemResponsavelId], references: [id], onDelete: SetNull)

  equipamentos Equipamento[]

  @@index([organizacaoId])
  @@index([dataEntrada])
  @@map("lotes")
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Equipamento {
  id                   String              @id @default(uuid()) @db.Uuid
  codigoBarrasInterno  String              @unique
  tipo                 TipoEquipamento     @default(COMPUTADOR_MESA)
  marca                String              @default("")
  modelo               String              @default("")
  anoFabricacao        Int                 @default(0)
  estadoFisico         EstadoFisico        @default(NOVO)
  pesoQuilogramas      Float               @default(0)
  loteId               String              @db.VarChar(40)
  posicaoNoLote        Int                 @default(0)
  statusRastreamento   StatusRastreamento  @default(AGUARDANDO_TRIAGEM)

  lote                 Lote                @relation(fields: [loteId], references: [id], onDelete: Restrict)
  historicoMovimentacao Movimentacao[]
  registrosRecuperacao AnalyticsRecoveryRecord[]
  historicoCondicao AnalyticsConditionObservation[]

  @@index([loteId])
  @@index([statusRastreamento])
  @@map("equipamentos")
}

model Movimentacao {
  id            String      @id @default(uuid()) @db.Uuid
  equipamentoId String      @db.Uuid
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")

  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataHora])
  @@map("movimentacoes")
}

model Configuracao {
  id                    Int      @id @default(1)
  aliquotaImposto       Float
  coeficienteDepreciacao Float
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@map("configuracao")
}

model RegistroAuditoria {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String?   @db.Uuid
  acao        String    @db.VarChar(100)
  entidade    String    @db.VarChar(100)
  entidadeId  String?   @db.VarChar(100)
  detalhes    Json?
  ip          String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  criadoEm    DateTime  @default(now())

  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@map("registros_auditoria")
}

enum AnalyticsReportType {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE_EQUIPAMENTO
  VIDA_UTIL_REMANESCENTE
}

model AnalyticsReport {
  id String @id @default(uuid()) @db.Uuid
  type AnalyticsReportType
  organizationId String? @db.VarChar(20)
  generatedAt DateTime @default(now())
  modelVersion String @db.VarChar(30)
  parameters Json
  summary Json?
  operacional AnalyticsOperationalResult[]
  rentabilidade AnalyticsProfitabilityResult[]
  previsoes AnalyticsRemainingLifeResult[]
  @@index([type, generatedAt])
  @@index([organizationId, generatedAt])
  @@map("analytics_reports")
}

model AnalyticsOperationalResult {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  operatorId String? @db.Uuid
  operatorName String
  periodStart DateTime
  periodEnd DateTime
  lotesConcluidos Int
  tempoMedioHoras Float?
  tempoMedianoHoras Float?
  desvioPadraoHoras Float?
  detalhes Json?
  report AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@index([reportId, periodStart])
  @@map("analytics_operational_results")
}

model AnalyticsProfitabilityResult {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  tipo TipoEquipamento
  estadoFisico EstadoFisico
  marca String
  modelo String
  quantidade Int
  valorTotal Decimal @db.Decimal(14, 2)
  valorMedio Decimal @db.Decimal(14, 2)
  ranking Int?
  report AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@index([reportId, ranking])
  @@map("analytics_profitability_results")
}

model AnalyticsRemainingLifeResult {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  tipo TipoEquipamento
  marca String
  modelo String
  idadeAtualAnos Float?
  vidaRemanescenteAnos Float?
  dataPrevistaInservivel DateTime?
  rSquared Float?
  amostras Int
  metodo String @db.VarChar(40)
  detalhes Json?
  report AnalyticsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@index([reportId])
  @@map("analytics_remaining_life_results")
}

model AnalyticsRecoveryRecord {
  id String @id @default(uuid()) @db.Uuid
  equipamentoId String @db.Uuid
  valorRecuperado Decimal @db.Decimal(14, 2)
  moeda String @default("BRL") @db.VarChar(3)
  recuperadoEm DateTime @default(now())
  descricao String? @db.Text
  criadoEm DateTime @default(now())
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  @@index([equipamentoId, recuperadoEm])
  @@map("analytics_recovery_records")
}

model AnalyticsConditionObservation {
  id String @id @default(uuid()) @db.Uuid
  equipamentoId String @db.Uuid
  observadoEm DateTime @default(now())
  indicadorCondicao Float
  percentualDepreciacao Float?
  falhaRegistrada Boolean @default(false)
  descricao String? @db.Text
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  @@index([equipamentoId, observadoEm])
  @@map("analytics_condition_observations")
}
